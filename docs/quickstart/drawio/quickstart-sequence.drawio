<mxfile host="app.diagrams.net">
  <diagram name="Сценарий быстрого старта" id="quickstart-gost">
    <mxGraphModel dx="1000" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="800" pageHeight="1100" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Заголовок схемы -->
        <mxCell id="title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Times New Roman;fontStyle=1;fontSize=15;fontColor=#000000;" value="Сценарий локального запуска и проверки API (quickstart)" vertex="1">
          <mxGeometry x="100" y="20" width="600" height="30" as="geometry" />
        </mxCell>

        <!-- 1. Начало -->
        <mxCell id="start" parent="1" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.terminator;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=12;fontStyle=1;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;" value="Начало" vertex="1">
          <mxGeometry x="340" y="70" width="120" height="40" as="geometry" />
        </mxCell>

        <!-- 2. Команда docker compose -->
        <mxCell id="cmd_docker" parent="1" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fontFamily=Times New Roman;fontSize=12;fontColor=#000000;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;" value="Ввод: docker compose up -d" vertex="1">
          <mxGeometry x="300" y="140" width="200" height="45" as="geometry" />
        </mxCell>
        <mxCell id="e1" edge="1" parent="1" source="start" target="cmd_docker" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 3. Ожидание готовности -->
        <mxCell id="proc_wait" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=12;fontColor=#000000;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;" value="Инициализация Postgres, Redis, RabbitMQ, Gateway" vertex="1">
          <mxGeometry x="270" y="215" width="260" height="40" as="geometry" />
        </mxCell>
        <mxCell id="e2" edge="1" parent="1" source="cmd_docker" target="proc_wait" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 4. Условие готовности -->
        <mxCell id="cond_healthy" parent="1" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=12;fontColor=#000000;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;" value="Все сервисы healthy?" vertex="1">
          <mxGeometry x="320" y="285" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e3" edge="1" parent="1" source="proc_wait" target="cond_healthy" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Ветка Нет -->
        <mxCell id="e_unhealthy" edge="1" parent="1" source="cond_healthy" target="proc_wait" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=11;fontColor=#000000;" value="Нет (ожидание)">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="580" y="315" />
              <mxPoint x="580" y="235" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- 5. Открытие браузера -->
        <mxCell id="in_browser" parent="1" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fontFamily=Times New Roman;fontSize=12;fontColor=#000000;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;" value="Переход на http://localhost:8080/docs" vertex="1">
          <mxGeometry x="270" y="380" width="260" height="45" as="geometry" />
        </mxCell>
        <mxCell id="e4" edge="1" parent="1" source="cond_healthy" target="in_browser" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=11;fontColor=#000000;" value="Да">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 6. Вызов DevLogin -->
        <mxCell id="call_devlogin" parent="1" style="shape=process;backgroundOutline=1;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=12;fontColor=#000000;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;" value="POST /api/v1/auth/dev-login (роль: student)" vertex="1">
          <mxGeometry x="270" y="455" width="260" height="45" as="geometry" />
        </mxCell>
        <mxCell id="e5" edge="1" parent="1" source="in_browser" target="call_devlogin" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 7. Получение токена -->
        <mxCell id="out_jwt" parent="1" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fontFamily=Times New Roman;fontSize=12;fontColor=#000000;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;" value="Вывод: access_token (JWT Ed25519)" vertex="1">
          <mxGeometry x="280" y="530" width="240" height="45" as="geometry" />
        </mxCell>
        <mxCell id="e6" edge="1" parent="1" source="call_devlogin" target="out_jwt" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 8. Авторизация в Swagger -->
        <mxCell id="proc_auth_hdr" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=12;fontColor=#000000;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;" value="Swagger UI: кнопка Authorize, подстановка Bearer" vertex="1">
          <mxGeometry x="260" y="605" width="280" height="40" as="geometry" />
        </mxCell>
        <mxCell id="e7" edge="1" parent="1" source="out_jwt" target="proc_auth_hdr" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 9. Вызов CreateTask -->
        <mxCell id="call_task" parent="1" style="shape=process;backgroundOutline=1;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=12;fontColor=#000000;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;" value="POST /api/v1/tasks (создание учебной задачи)" vertex="1">
          <mxGeometry x="270" y="675" width="260" height="45" as="geometry" />
        </mxCell>
        <mxCell id="e8" edge="1" parent="1" source="proc_auth_hdr" target="call_task" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 10. Условие 201 Created -->
        <mxCell id="cond_status" parent="1" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=12;fontColor=#000000;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;" value="HTTP Status == 201?" vertex="1">
          <mxGeometry x="320" y="750" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e9" edge="1" parent="1" source="call_task" target="cond_status" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Успех -->
        <mxCell id="out_ok" parent="1" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fontFamily=Times New Roman;fontSize=12;fontColor=#000000;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;" value="Вывод: Задача создана (стек работает штатно)" vertex="1">
          <mxGeometry x="250" y="845" width="300" height="45" as="geometry" />
        </mxCell>
        <mxCell id="e10" edge="1" parent="1" source="cond_status" target="out_ok" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=11;fontColor=#000000;" value="Да">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Ошибка -->
        <mxCell id="out_err" parent="1" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fontFamily=Times New Roman;fontSize=12;fontColor=#000000;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;" value="Вывод: Ошибка валидации или прав доступа" vertex="1">
          <mxGeometry x="40" y="845" width="180" height="45" as="geometry" />
        </mxCell>
        <mxCell id="e_err" edge="1" parent="1" source="cond_status" target="out_err" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=11;fontColor=#000000;" value="Нет">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="130" y="780" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Конец -->
        <mxCell id="finish" parent="1" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.terminator;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=12;fontStyle=1;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;" value="Конец" vertex="1">
          <mxGeometry x="340" y="930" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="e11" edge="1" parent="1" source="out_ok" target="finish" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e12" edge="1" parent="1" source="out_err" target="finish" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="130" y="950" />
            </Array>
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>