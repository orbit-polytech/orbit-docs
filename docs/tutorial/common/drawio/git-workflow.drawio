<mxfile host="app.diagrams.net">
  <diagram name="Orbit AI Git Workflow" id="orbit-git-workflow">
    <mxGraphModel dx="1000" dy="500" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="500" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Заголовок -->
        <mxCell id="title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Segoe UI, Arial, sans-serif;fontStyle=1;fontSize=15;fontColor=#0f172a;" value="Orbit AI Git Workflow • Linear History &amp;amp; Short-Lived Feature Branches" vertex="1">
          <mxGeometry x="30" y="20" width="800" height="30" as="geometry" />
        </mxCell>
        <mxCell id="sub" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Segoe UI, Arial, sans-serif;fontSize=11;fontColor=#64748b;" value="Стандарт командной разработки: ветки, Conventional Commits, Rebase и Squash Merge" vertex="1">
          <mxGeometry x="30" y="45" width="650" height="20" as="geometry" />
        </mxCell>

        <!-- Бейдж ветки main -->
        <mxCell id="badge_main" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#2563eb;strokeWidth=1.5;fillColor=#eff6ff;fontFamily=Segoe UI, Arial, sans-serif;fontStyle=1;fontSize=12;fontColor=#1d4ed8;" value="main" vertex="1">
          <mxGeometry x="30" y="95" width="80" height="32" as="geometry" />
        </mxCell>
        <!-- Линия ветки main -->
        <mxCell id="line_main" parent="1" style="endArrow=none;html=1;strokeColor=#2563eb;strokeWidth=4;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="120" y="111" as="sourcePoint" />
            <mxPoint x="920" y="111" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Бейдж ветки feature -->
        <mxCell id="badge_feature" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#d97706;strokeWidth=1.5;fillColor=#fffbeb;fontFamily=Segoe UI, Arial, sans-serif;fontStyle=1;fontSize=11;fontColor=#b45309;" value="feature/task-filters" vertex="1">
          <mxGeometry x="30" y="240" width="180" height="32" as="geometry" />
        </mxCell>
        <!-- Линия ветки feature -->
        <mxCell id="line_feature" parent="1" style="endArrow=none;html=1;strokeColor=#d97706;strokeWidth=4;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="310" y="256" as="sourcePoint" />
            <mxPoint x="760" y="256" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Ответвление feature от main -->
        <mxCell id="curve_branch" parent="1" style="edgeStyle=orthogonalEdgeStyle;curved=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d97706;strokeWidth=4;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="230" y="111" as="sourcePoint" />
            <mxPoint x="310" y="256" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Слияние Squash & Merge обратно в main -->
        <mxCell id="curve_merge" parent="1" style="edgeStyle=orthogonalEdgeStyle;curved=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16a34a;strokeWidth=4;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="760" y="256" as="sourcePoint" />
            <mxPoint x="840" y="111" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Коммит 1 на main: v1.0.0 -->
        <mxCell id="c_main_v1" parent="1" style="ellipse;whiteSpace=wrap;html=1;strokeColor=#2563eb;strokeWidth=3;fillColor=#ffffff;" vertex="1">
          <mxGeometry x="220" y="101" width="20" height="20" as="geometry" />
        </mxCell>
        <mxCell id="tag_v1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#64748b;strokeWidth=1;fillColor=#f1f5f9;fontFamily=Segoe UI, Arial, sans-serif;fontStyle=1;fontSize=10;fontColor=#334155;" value="v1.0.0" vertex="1">
          <mxGeometry x="195" y="65" width="70" height="24" as="geometry" />
        </mxCell>

        <!-- Параллельный коммит в main: fix(auth): validate token exp -->
        <mxCell id="c_main_fix" parent="1" style="ellipse;whiteSpace=wrap;html=1;strokeColor=#2563eb;strokeWidth=3;fillColor=#ffffff;" vertex="1">
          <mxGeometry x="525" y="101" width="20" height="20" as="geometry" />
        </mxCell>
        <mxCell id="card_main_fix" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#93c5fd;strokeWidth=1;fillColor=#eff6ff;fontFamily=Segoe UI, Arial, sans-serif;fontSize=10.5;fontColor=#1e40af;" value="&lt;b&gt;fix(auth):&lt;/b&gt; validate token exp" vertex="1">
          <mxGeometry x="430" y="55" width="210" height="34" as="geometry" />
        </mxCell>

        <!-- Итоговый коммит в main: PR #42 (Squash & Merge) -->
        <mxCell id="c_main_pr" parent="1" style="ellipse;whiteSpace=wrap;html=1;strokeColor=#16a34a;strokeWidth=3.5;fillColor=#dcfce7;" vertex="1">
          <mxGeometry x="840" y="99" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="card_main_pr" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#16a34a;strokeWidth=1.5;fillColor=#f0fdf4;fontFamily=Segoe UI, Arial, sans-serif;fontSize=10;fontColor=#15803d;" value="&lt;b style=&quot;font-size:11px;&quot;&gt;PR #42 (Squash &amp;amp; Merge)&lt;/b&gt;&lt;br/&gt;1 атомарный коммит в main" vertex="1">
          <mxGeometry x="725" y="50" width="240" height="38" as="geometry" />
        </mxCell>

        <!-- Коммит 1 в feature: feat(domain): add priority filter -->
        <mxCell id="c_feat_1" parent="1" style="ellipse;whiteSpace=wrap;html=1;strokeColor=#d97706;strokeWidth=3;fillColor=#ffffff;" vertex="1">
          <mxGeometry x="400" y="246" width="20" height="20" as="geometry" />
        </mxCell>
        <mxCell id="card_feat_1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#fcd34d;strokeWidth=1;fillColor=#fffbeb;fontFamily=Segoe UI, Arial, sans-serif;fontSize=10.5;fontColor=#92400e;" value="&lt;b&gt;feat(domain):&lt;/b&gt; add priority filter&lt;br/&gt;&lt;span style=&quot;font-size:9.5px;color:#a16207;&quot;&gt;коммит 1 в локальной ветке&lt;/span&gt;" vertex="1">
          <mxGeometry x="285" y="280" width="250" height="44" as="geometry" />
        </mxCell>

        <!-- Коммит 2 в feature: test(domain): unit test filters -->
        <mxCell id="c_feat_2" parent="1" style="ellipse;whiteSpace=wrap;html=1;strokeColor=#d97706;strokeWidth=3;fillColor=#ffffff;" vertex="1">
          <mxGeometry x="660" y="246" width="20" height="20" as="geometry" />
        </mxCell>
        <mxCell id="card_feat_2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#fcd34d;strokeWidth=1;fillColor=#fffbeb;fontFamily=Segoe UI, Arial, sans-serif;fontSize=10.5;fontColor=#92400e;" value="&lt;b&gt;test(domain):&lt;/b&gt; unit test filters&lt;br/&gt;&lt;span style=&quot;font-size:9.5px;color:#a16207;&quot;&gt;коммит 2 в локальной ветке&lt;/span&gt;" vertex="1">
          <mxGeometry x="550" y="280" width="240" height="44" as="geometry" />
        </mxCell>

        <!-- Подсказка Rebase -->
        <mxCell id="pill_rebase" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#db2777;strokeWidth=1.5;fillColor=#fdf2f8;fontFamily=Segoe UI, Arial, sans-serif;fontStyle=1;fontSize=11;fontColor=#9d174d;" value="git rebase origin/main" vertex="1">
          <mxGeometry x="445" y="170" width="180" height="28" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
