        <mxCell id="edge_mesh_rmq" parent="1" source="zone_mesh" target="infra_rmq" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeColor=#ea580c;strokeWidth=1.5;" edge="1">
