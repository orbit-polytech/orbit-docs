        <mxCell id="edge_mesh_jaeger" parent="1" source="zone_mesh" target="infra_jaeger" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeColor=#0d9488;strokeWidth=1.5;" edge="1">
