<mxfile host="app.diagrams.net">
  <diagram name="Архитектура экосистемы Orbit AI" id="orbit-arch-overview">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="800" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- Заголовок схемы -->
        <mxCell id="title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Segoe UI, Arial, sans-serif;fontStyle=1;fontSize=16;fontColor=#0f172a;" value="Orbit AI • Архитектура распределенной экосистемы микросервисов" vertex="1">
          <mxGeometry x="30" y="20" width="700" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Segoe UI, Arial, sans-serif;fontSize=12;fontColor=#64748b;" value="github.com/orbit-polytech (13 специализированных репозиториев)" vertex="1">
          <mxGeometry x="750" y="20" width="400" height="30" as="geometry" />
        </mxCell>
        
        <!-- 1. Зона клиентов -->
        <mxCell id="zone_clients" parent="1" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;strokeColor=#94a3b8;strokeWidth=1.5;fillColor=#f8fafc;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontFamily=Segoe UI, Arial, sans-serif;fontStyle=1;fontSize=11;fontColor=#475569;" value="ВНЕШНИЙ КОНТУР • КЛИЕНТЫ (UNTRUSTED)" vertex="1">
          <mxGeometry x="30" y="65" width="1120" height="100" as="geometry" />
        </mxCell>
        <mxCell id="client_mobile" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#0284c7;strokeWidth=1.5;fillColor=#ffffff;fontFamily=Segoe UI, Arial, sans-serif;fontSize=12;fontColor=#0f172a;" value="&lt;b style=&quot;color:#0284c7;font-size:13px;&quot;&gt;📱 mobile&lt;/b&gt;&lt;br/&gt;Flutter 3.x • MVVM &amp;amp; BLoC&lt;br/&gt;&lt;span style=&quot;color:#64748b;font-size:10px;&quot;&gt;iOS / Android клиент&lt;/span&gt;" vertex="1">
          <mxGeometry x="60" y="90" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="client_bot" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#0284c7;strokeWidth=1.5;fillColor=#ffffff;fontFamily=Segoe UI, Arial, sans-serif;fontSize=12;fontColor=#0f172a;" value="&lt;b style=&quot;color:#0284c7;font-size:13px;&quot;&gt;🤖 bot-service&lt;/b&gt;&lt;br/&gt;Python 3.12 • aiogram 3&lt;br/&gt;&lt;span style=&quot;color:#64748b;font-size:10px;&quot;&gt;Telegram-интерфейс&lt;/span&gt;" vertex="1">
          <mxGeometry x="450" y="90" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="client_web" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#0284c7;strokeWidth=1.5;fillColor=#ffffff;fontFamily=Segoe UI, Arial, sans-serif;fontSize=12;fontColor=#0f172a;" value="&lt;b style=&quot;color:#0284c7;font-size:13px;&quot;&gt;🌐 Web &amp;amp; Swagger UI&lt;/b&gt;&lt;br/&gt;OpenAPI 3.1 • HTTP REST&lt;br/&gt;&lt;span style=&quot;color:#64748b;font-size:10px;&quot;&gt;Браузер разработчика&lt;/span&gt;" vertex="1">
          <mxGeometry x="840" y="90" width="280" height="60" as="geometry" />
        </mxCell>

        <!-- Протокол REST -->
        <mxCell id="badge_rest" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#0284c7;strokeWidth=1;fillColor=#e0f2fe;fontFamily=Segoe UI, Arial, sans-serif;fontStyle=1;fontSize=10;fontColor=#0369a1;" value="HTTPS REST JSON • Ed25519 JWT" vertex="1">
          <mxGeometry x="475" y="180" width="230" height="24" as="geometry" />
        </mxCell>
        <mxCell id="edge_c1_gw" parent="1" source="client_mobile" target="gateway" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284c7;strokeWidth=2;" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_c2_gw" parent="1" source="client_bot" target="gateway" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284c7;strokeWidth=2;" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_c3_gw" parent="1" source="client_web" target="gateway" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284c7;strokeWidth=2;" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 2. Периметр безопасности (API Gateway) -->
        <mxCell id="gateway" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#6366f1;strokeWidth=2;fillColor=#f5f3ff;fontFamily=Segoe UI, Arial, sans-serif;fontSize=12;fontColor=#1e1b4b;" value="&lt;b style=&quot;font-size:13px;color:#4338ca;&quot;&gt;🛡️ gateway-service (:8080)&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;color:#3730a3;&quot;&gt;Валидация JWT Ed25519 • Проверка Blacklist (Redis) • Rate Limiting • CORS • Инъекция x-user-id в gRPC&lt;/span&gt;" vertex="1">
          <mxGeometry x="170" y="215" width="840" height="66" as="geometry" />
        </mxCell>

        <!-- Протокол gRPC -->
        <mxCell id="badge_grpc" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#6366f1;strokeWidth=1;fillColor=#ede9fe;fontFamily=Segoe UI, Arial, sans-serif;fontStyle=1;fontSize=10;fontColor=#4338ca;" value="gRPC over HTTP/2 • Metadata: x-user-id" vertex="1">
          <mxGeometry x="465" y="295" width="250" height="24" as="geometry" />
        </mxCell>
        <mxCell id="edge_gw_mesh" parent="1" source="gateway" target="zone_mesh" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6366f1;strokeWidth=2.5;" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 3. Доверенный контур микросервисов -->
        <mxCell id="zone_mesh" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#94a3b8;strokeWidth=1.5;fillColor=#f8fafc;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontFamily=Segoe UI, Arial, sans-serif;fontStyle=1;fontSize=11;fontColor=#0284c7;" value="ВНУТРЕННИЙ ДОВЕРЕННЫЙ КОНТУР (orbit-net)" vertex="1">
          <mxGeometry x="30" y="330" width="1120" height="225" as="geometry" />
        </mxCell>

        <!-- Микросервисы -->
        <mxCell id="svc_auth" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#0284c7;strokeWidth=1.5;fillColor=#ffffff;fontFamily=Segoe UI, Arial, sans-serif;fontSize=11;fontColor=#0f172a;" value="&lt;b style=&quot;color:#0284c7;&quot;&gt;auth-service&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;color:#0284c7;font-size:9.5px;&quot;&gt;:50051&lt;/span&gt;&lt;br/&gt;Ed25519 ключи&lt;br/&gt;Сессии / TG Auth" vertex="1">
          <mxGeometry x="45" y="375" width="140" height="92" as="geometry" />
        </mxCell>
        <mxCell id="svc_users" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#0284c7;strokeWidth=1.5;fillColor=#ffffff;fontFamily=Segoe UI, Arial, sans-serif;fontSize=11;fontColor=#0f172a;" value="&lt;b style=&quot;color:#0284c7;&quot;&gt;users-service&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;color:#0284c7;font-size:9.5px;&quot;&gt;:50052&lt;/span&gt;&lt;br/&gt;Профили студентов&lt;br/&gt;Группы и роли" vertex="1">
          <mxGeometry x="205" y="375" width="140" height="92" as="geometry" />
        </mxCell>
        <mxCell id="svc_schedule" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#0284c7;strokeWidth=1.5;fillColor=#ffffff;fontFamily=Segoe UI, Arial, sans-serif;fontSize=11;fontColor=#0f172a;" value="&lt;b style=&quot;color:#0284c7;&quot;&gt;schedule-service&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;color:#0284c7;font-size:9.5px;&quot;&gt;:50053&lt;/span&gt;&lt;br/&gt;Парсинг расписания&lt;br/&gt;Кэш пар в Redis" vertex="1">
          <mxGeometry x="365" y="375" width="140" height="92" as="geometry" />
        </mxCell>
        <mxCell id="svc_nav" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#0284c7;strokeWidth=1.5;fillColor=#ffffff;fontFamily=Segoe UI, Arial, sans-serif;fontSize=11;fontColor=#0f172a;" value="&lt;b style=&quot;color:#0284c7;&quot;&gt;nav-service&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;color:#0284c7;font-size:9.5px;&quot;&gt;:50054&lt;/span&gt;&lt;br/&gt;Корпуса Политеха&lt;br/&gt;Маршруты и карты" vertex="1">
          <mxGeometry x="525" y="375" width="140" height="92" as="geometry" />
        </mxCell>
        <mxCell id="svc_tasks" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#059669;strokeWidth=2;fillColor=#ecfdf5;fontFamily=Segoe UI, Arial, sans-serif;fontSize=11;fontColor=#0f172a;" value="&lt;b style=&quot;color:#059669;&quot;&gt;tasks-service&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;color:#059669;font-size:9.5px;&quot;&gt;:50055&lt;/span&gt;&lt;br/&gt;Clean Architecture&lt;br/&gt;Transactional Outbox" vertex="1">
          <mxGeometry x="685" y="375" width="140" height="92" as="geometry" />
        </mxCell>
        <mxCell id="svc_notif" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#d97706;strokeWidth=1.5;fillColor=#fffbeb;fontFamily=Segoe UI, Arial, sans-serif;fontSize=11;fontColor=#0f172a;" value="&lt;b style=&quot;color:#d97706;&quot;&gt;notif-service&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;color:#d97706;font-size:9.5px;&quot;&gt;:50056&lt;/span&gt;&lt;br/&gt;Push / TG Sender&lt;br/&gt;AMQP Consumer" vertex="1">
          <mxGeometry x="845" y="375" width="140" height="92" as="geometry" />
        </mxCell>
        <mxCell id="svc_ai" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#7c3aed;strokeWidth=1.5;fillColor=#f5f3ff;fontFamily=Segoe UI, Arial, sans-serif;fontSize=11;fontColor=#0f172a;" value="&lt;b style=&quot;color:#7c3aed;&quot;&gt;ai-service&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;color:#7c3aed;font-size:9.5px;&quot;&gt;:50057&lt;/span&gt;&lt;br/&gt;RAG &amp;amp; pgvector&lt;br/&gt;Gemini 2.0 Flash" vertex="1">
          <mxGeometry x="1005" y="375" width="140" height="92" as="geometry" />
        </mxCell>

        <!-- Асинхронный поток Outbox -> RabbitMQ -> notif-service -->
        <mxCell id="edge_outbox" parent="1" source="svc_tasks" target="svc_notif" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeColor=#d97706;strokeWidth=2;fontFamily=Segoe UI, Arial, sans-serif;fontSize=10;fontColor=#b45309;" value="Outbox: task.created ──&gt; RabbitMQ ──&gt; notif-service" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="755" y="500" />
              <mxPoint x="915" y="500" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- 4. Инфраструктура хранения и очередей -->
        <mxCell id="zone_infra" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#94a3b8;strokeWidth=1.5;fillColor=#f8fafc;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontFamily=Segoe UI, Arial, sans-serif;fontStyle=1;fontSize=11;fontColor=#059669;" value="ИНФРАСТРУКТУРА ХРАНЕНИЯ И БРОКЕРОВ (infra)" vertex="1">
          <mxGeometry x="30" y="585" width="1120" height="155" as="geometry" />
        </mxCell>
        <mxCell id="infra_pg" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#0284c7;strokeWidth=1.5;fillColor=#ffffff;fontFamily=Segoe UI, Arial, sans-serif;fontSize=11;fontColor=#0f172a;" value="&lt;b style=&quot;color:#0284c7;font-size:12px;&quot;&gt;🐘 PostgreSQL 16 (:5432)&lt;/b&gt;&lt;br/&gt;Схемы: auth, users, tasks, schedule&lt;br/&gt;Расширение: pgvector (vector 768)&lt;br/&gt;&lt;span style=&quot;color:#64748b;font-size:10px;&quot;&gt;Реляционная целостность и ACID&lt;/span&gt;" vertex="1">
          <mxGeometry x="45" y="615" width="255" height="105" as="geometry" />
        </mxCell>
        <mxCell id="infra_redis" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#dc2626;strokeWidth=1.5;fillColor=#ffffff;fontFamily=Segoe UI, Arial, sans-serif;fontSize=11;fontColor=#0f172a;" value="&lt;b style=&quot;color:#dc2626;font-size:12px;&quot;&gt;⚡ Redis 7.2 (:6379)&lt;/b&gt;&lt;br/&gt;Кэш расписания (Cache-Aside)&lt;br/&gt;Blacklist токенов по jti&lt;br/&gt;&lt;span style=&quot;color:#64748b;font-size:10px;&quot;&gt;Rate Limiting и чтение &amp;lt;2мс&lt;/span&gt;" vertex="1">
          <mxGeometry x="325" y="615" width="255" height="105" as="geometry" />
        </mxCell>
        <mxCell id="infra_rmq" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#ea580c;strokeWidth=1.5;fillColor=#ffffff;fontFamily=Segoe UI, Arial, sans-serif;fontSize=11;fontColor=#0f172a;" value="&lt;b style=&quot;color:#ea580c;font-size:12px;&quot;&gt;🐇 RabbitMQ 4 (:5672)&lt;/b&gt;&lt;br/&gt;AMQP 0-9-1 Topic Exchange&lt;br/&gt;Очереди событий + DLX / DLQ&lt;br/&gt;&lt;span style=&quot;color:#64748b;font-size:10px;&quot;&gt;At-Least-Once доставка сообщений&lt;/span&gt;" vertex="1">
          <mxGeometry x="605" y="615" width="255" height="105" as="geometry" />
        </mxCell>
        <mxCell id="infra_jaeger" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#0d9488;strokeWidth=1.5;fillColor=#ffffff;fontFamily=Segoe UI, Arial, sans-serif;fontSize=11;fontColor=#0f172a;" value="&lt;b style=&quot;color:#0d9488;font-size:12px;&quot;&gt;🔍 Jaeger 2 (:4318)&lt;/b&gt;&lt;br/&gt;OpenTelemetry Tracing&lt;br/&gt;Сквозной trace_id по RPC&lt;br/&gt;&lt;span style=&quot;color:#64748b;font-size:10px;&quot;&gt;Мониторинг латентности сервисов&lt;/span&gt;" vertex="1">
          <mxGeometry x="885" y="615" width="255" height="105" as="geometry" />
        </mxCell>

        <!-- Связи между Mesh и Infra -->
        <mxCell id="edge_mesh_pg" parent="1" source="zone_mesh" target="infra_pg" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeColor=#0284c7;strokeWidth=1.5;" edge="1">
          <mxGeometry relative="1" as="geometry" />
