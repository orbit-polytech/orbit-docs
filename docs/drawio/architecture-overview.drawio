        <mxCell id="edge_mesh_redis" parent="1" source="zone_mesh" target="infra_redis" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeColor=#dc2626;strokeWidth=1.5;" edge="1">
          <mxGeometry relative="1" as="geometry" />
